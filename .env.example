# Required in production: random string, 32+ characters (e.g. `openssl rand -base64 48`)
SESSION_SECRET=
# Optional: if set, the first-admin setup form also requires this token
SETUP_TOKEN=
# Public origin used in exported links (never taken from the request Host header)
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_PATH=data/polls.db
RESPONSE_RETENTION_DAYS=365
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
PORT=3000
